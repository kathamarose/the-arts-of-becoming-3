          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Embodiment + Practice"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Come home through the body"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Yoga, meditation, somatics, movement, sensuality, breath, nervous-system awareness and embodied self-study."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Explore Embodiment →"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Courses + Circles"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We become in relationship"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "There is medicine in practicing together. Being witnessed. Hearing another person's story. Recognizing ourselves in one another."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Explore Circles →"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Earth + Living Systems"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Return to relationship with nature"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Plant medicine, gardens, ecology, seasonal living, rewilding, cultivation and regenerative ways of living."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Explore Earth →"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 3
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Creative Work"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Become through what you make and tell"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Writing, poetry, storytelling, music, design and visual worlds. Creation is one of the ways Life knows itself."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Enter the studio →"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
