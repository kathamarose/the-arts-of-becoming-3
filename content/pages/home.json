          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Kathleen"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Hi, I'm Kathleen."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Artist, photographer, teacher, guide + regenerative Renaissance woman."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I have spent much of my life exploring the intimate dance between nature and soul: how we come to know ourselves, how we free ourselves to express what we discover, and how we cultivate lives that feel increasingly true."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I used to wonder how all my work was supposed to fit together. Eventually I understood: "
                    },
                    {
                      "type": "text",
                      "text": "the weaving is the work.",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
