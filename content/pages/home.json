                    {
                      "type": "text",
                      "text": "True To Essence presents"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 1
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The Arts of Becoming"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A living body of work devoted to the art of being human."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Practices, experiences + creative works for remembering your nature, liberating what is alive, and bringing more of your truth into form."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "You are the medicine."
                    }
                  ]
                }
              ]
            }
          }
        },
