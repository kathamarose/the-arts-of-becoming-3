          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The threads"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Terrain we may explore."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "You do not choose one before we begin. These are examples of the terrain. The work follows the thread between them."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_btakvjwnnq",
      "preset": "starter/stack-12@1",
      "layout": {
        "mode": "stack",
