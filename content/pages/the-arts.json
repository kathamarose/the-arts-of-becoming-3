          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Embodiment + Practice",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The body is a door."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Yoga taught me early that self-knowledge is not only intellectual. We learn by breathing. Moving. Feeling. Pausing. Meeting resistance. Opening. Strengthening. Softening. Returning."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_1crj5v082r",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Alignment-based yoga + qi gong + intuitive movement + breath + stillness"
                        }
                      ]
                    }
                  ]
                },
                "heading": "FlowAsana"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Silent and guided practice"
                        }
                      ]
                    }
                  ]
                },
                "heading": "Meditation"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Women's embodiment + feminine reclamation"
                        }
                      ]
                    }
                  ]
                },
                "heading": "Return to Her"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Seasonal embodiment, relationship, sensuality, ritual"
                        }
                      ]
                    }
                  ]
                },
                "heading": "Workshops"
              }
            ],
            "columns": "4",
            "aspect": "4:5"
          }
        }
      ]
    },
