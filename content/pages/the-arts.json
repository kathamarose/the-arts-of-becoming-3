              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Courses + Circles"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "We become in relationship."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Not all becoming needs to happen alone. There is medicine in practicing together. Being witnessed. Hearing another person's story. Recognizing ourselves in one another. Letting community become part of the mirror."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_7h0d3x0142",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A seven-part earth, body + ecstatic embodiment course"
                        }
                      ]
                    }
                  ]
                },
                "heading": "Ecstatic by Nature"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Storytelling for self-actualization + collective becoming"
                        }
                      ]
                    }
                  ]
                },
                "heading": "Story Weaving"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "When run as a cohort"
